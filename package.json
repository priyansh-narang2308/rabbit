{
  "name": "rabbit",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @rabbit/core\" \"npm run dev -w @rabbit/server\" \"npm run dev -w @rabbit/web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "allowScripts": {
    "better-sqlite3": true
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
